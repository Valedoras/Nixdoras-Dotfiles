prefer-no-csd

input {
    keyboard {
        xkb {
        }
    }

    touchpad {
        tap
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "Virtual-1" {
    mode "1920x1080@60"
    scale 0.9
    transform "normal"
    position x=1280 y=0

    hot-corners {
        off
    }
}

layout {
    gaps 13
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.1
        proportion 0.2
        proportion 0.3
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.7
        proportion 0.8
        proportion 0.9
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.1
        proportion 0.2
        proportion 0.3
        proportion 0.4
        proportion 0.5
        proportion 0.6
        proportion 0.7
        proportion 0.8
        proportion 0.9
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2
        active-color "#7393B3"
        inactive-color "#36454F"
        urgent-color "#36454F"
    }

    border {
        off
        width 3
        active-color "#FFFFFF"
        inactive-color "#FFFFFF"
        urgent-color "#FFFFFF"
    }

    shadow {
        // on
        softness 9
        spread 2
        offset x=0 y=5
        color "#000000"
    }

    struts {
    }
}

hotkey-overlay {
    skip-at-startup
}

gestures {
    hot-corners {
        off
        bottom-right
        bottom-left
        top-right
        top-left
    }
}

cursor {
    xcursor-theme "GoogleDot-Black"
    xcursor-size 10
    hide-when-typing
    hide-after-inactive-ms 4000
}

blur {
    saturation 0.9
    offset 2.0
    noise 0.04
    passes 2
}
