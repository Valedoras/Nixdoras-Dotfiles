window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

window-rule {
    open-maximized true
    opacity 1.0
    default-column-width { proportion 1.0; }
    default-window-height { proportion 1.0; }
}

window-rule {
    match app-id="^Alacritty$"
    match app-id="^kitty$"
    match app-id="^foot$"
    opacity 0.85
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 900; }
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    match app-id="^com\\.interversehq\\.qView$"
    opacity 1.0
    open-floating true
}

window-rule {
    match app-id="^org\\.gnome\\.Nautilus$"
    open-floating true
    opacity 1.0
    default-column-width { fixed 1400; }
    default-window-height { fixed 900; }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    match namespace="^mpvpaper*"
    place-within-backdrop true
}

overview {
    zoom 0.30
    workspace-shadow {
	    off
    }
}
